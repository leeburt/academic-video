{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Video Narrative Plan",
  "type": "object",
  "required": [
    "core_question",
    "viewer_promise",
    "core_tension",
    "core_surprise",
    "final_takeaway",
    "story_needed",
    "hook_type",
    "hook",
    "key_findings",
    "beats"
  ],
  "properties": {
    "core_question": {"type": "string", "minLength": 1},
    "viewer_promise": {"type": "string", "minLength": 1},
    "core_tension": {"type": "string", "minLength": 1},
    "core_surprise": {"type": "string", "minLength": 1},
    "final_takeaway": {"type": "string", "minLength": 1},
    "story_needed": {"type": "boolean"},
    "hook_type": {
      "type": "string",
      "enum": [
        "counterintuitive_finding",
        "expectation_reversal",
        "unresolved_question",
        "result_first",
        "concrete_case",
        "contrast_case",
        "abnormal_number",
        "fictional_story"
      ]
    },
    "hook": {"type": "string", "minLength": 1},
    "key_findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "key_numbers": {
      "type": "array",
      "maxItems": 4,
      "items": {}
    },
    "method_needed": {"type": ["string", "null"]},
    "limitation": {"type": ["string", "null"]},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "viewer_state_before",
          "question",
          "new_information",
          "viewer_state_after",
          "claim_ids"
        ],
        "properties": {
          "beat_id": {"type": "string"},
          "viewer_state_before": {"type": "string"},
          "question": {"type": "string"},
          "expected_answer": {"type": ["string", "null"]},
          "new_information": {"type": "string"},
          "surprise": {"type": ["string", "null"]},
          "viewer_state_after": {"type": "string"},
          "next_question": {"type": ["string", "null"]},
          "claim_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
