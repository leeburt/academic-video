{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Video Storyboard",
  "type": "object",
  "required": ["title", "target_duration", "scenes"],
  "properties": {
    "title": {"type": "string"},
    "target_duration": {"type": "number", "minimum": 1},
    "scenes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Shot-level scene",
            "type": "object",
            "required": ["scene_id", "shots"],
            "properties": {
              "scene_id": {"type": "string"},
              "beat_id": {"type": ["string", "null"]},
              "purpose": {"type": ["string", "null"]},
              "notes": {"type": ["string", "null"]},
              "shots": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/shot"}
              }
            },
            "additionalProperties": false
          },
          {
            "title": "Legacy scene",
            "type": "object",
            "required": [
              "scene_id",
              "duration",
              "narration",
              "claim_ids",
              "visual_type",
              "renderer"
            ],
            "properties": {
              "scene_id": {"type": "string"},
              "duration": {"type": "number", "minimum": 0.5},
              "narration": {"type": "string"},
              "claim_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "visual_intent": {"type": "string"},
              "visual_type": {"$ref": "#/$defs/visual_type"},
              "renderer": {"$ref": "#/$defs/renderer"},
              "assets": {
                "type": "array",
                "items": {"type": "string"}
              },
              "notes": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "$defs": {
    "visual_type": {
      "type": "string",
      "enum": [
        "paper_evidence",
        "data_visualization",
        "concept_diagram",
        "method_animation",
        "cinematic",
        "typography"
      ]
    },
    "renderer": {
      "type": "string",
      "enum": [
        "hyperframes",
        "manim",
        "video_model",
        "direct_asset",
        "ffmpeg",
        "static"
      ]
    },
    "transition_type": {
      "type": ["string", "null"],
      "enum": [
        "action",
        "gaze",
        "object",
        "shape",
        "sound",
        "semantic",
        "match_cut",
        "fade",
        "hard_cut",
        null
      ]
    },
    "shot": {
      "type": "object",
      "required": [
        "shot_id",
        "duration",
        "purpose",
        "narration",
        "claim_ids",
        "visual_intent",
        "visual_type",
        "renderer"
      ],
      "properties": {
        "shot_id": {"type": "string"},
        "beat_id": {"type": ["string", "null"]},
        "duration": {"type": "number", "minimum": 0.25},
        "purpose": {
          "type": "string",
          "enum": ["evidence", "explanation", "story", "transition"]
        },
        "narration": {"type": "string"},
        "claim_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "visual_intent": {"type": "string"},
        "visual_type": {"$ref": "#/$defs/visual_type"},
        "characters": {
          "type": "array",
          "items": {"type": "string"}
        },
        "assets": {
          "type": "array",
          "items": {"type": "string"}
        },
        "entry_state": {"type": ["string", "null"]},
        "exit_state": {"type": ["string", "null"]},
        "continuity_in": {"type": ["string", "null"]},
        "continuity_out": {"type": ["string", "null"]},
        "transition_type": {"$ref": "#/$defs/transition_type"},
        "image_prompt": {"type": ["string", "null"]},
        "video_prompt": {"type": ["string", "null"]},
        "renderer": {"$ref": "#/$defs/renderer"},
        "fallback_renderer": {
          "oneOf": [
            {"$ref": "#/$defs/renderer"},
            {"type": "null"}
          ]
        },
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
